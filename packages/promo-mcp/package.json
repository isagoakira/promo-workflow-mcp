{
  "name": "@promo-workflow/mcp-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "promo-workflow-mcp": "dist/index.js"
  },
  "scripts": {
    "prebuild": "npm run build --workspace=@promo-workflow/service",
